{
  "name": "desk-tools",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && npm run check:public",
    "check:public": "node scripts/check-public-output.mjs",
    "build:standalone": "npm run typecheck && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "4.0.18"
  }
}
