FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts ./scripts
COPY public ./public
COPY src ./src
COPY index.html tsconfig.json vite.config.ts ./
ARG RAILWAY_PUBLIC_DOMAIN
RUN VITE_ROOMS_URL="https://${RAILWAY_PUBLIC_DOMAIN}" npm run build:rooms:public

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/dist-rooms ./dist-rooms
COPY --from=build /app/downloads/desk.html ./downloads/desk.html
ENV PORT=8080 ROOMS_HOST=0.0.0.0 ROOMS_DOWNLOAD_HTML=downloads/desk.html ROOMS_ORIGINS=https://hym3274.github.io
EXPOSE 8080
USER node
CMD ["node", "dist-rooms/server.js"]
